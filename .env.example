# ─────────────────────────────────────────────────────────────────────────────
# QLYQ — MCP-Powered AI Project and Developer Assistant (.env.example)
# Tagline: Think less. Ship more.
# Copy this file to .env and adjust variables as needed.
# NEVER commit the real .env file with sensitive secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────
# Local development default: mongodb://127.0.0.1:27017/trackmate
# Docker Compose default (inter-container): mongodb://mongodb:27017/trackmate
# External MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/trackmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trackmate

# ─────────────────────────────────────────────
# BACKEND API GATEWAY (Port 3001)
# ─────────────────────────────────────────────
PORT=3001
# URL of the MCP server endpoint
# Local dev: http://localhost:3002
# Docker Compose: http://mcp-server:3002 (overridden automatically in docker-compose.yml)
MCP_SERVER_URL=http://localhost:3002
JWT_SECRET=change-me-in-production-use-a-long-random-string
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─────────────────────────────────────────────
# MCP SERVER (Port 3002)
# ─────────────────────────────────────────────
MCP_PORT=3002

# ─────────────────────────────────────────────
# AI PROVIDER & AWS BEDROCK SETTINGS
# ─────────────────────────────────────────────
# Options: "mock" (offline, zero-cost, no AWS credentials needed) or "bedrock"
AI_PROVIDER=mock

# Required ONLY if AI_PROVIDER=bedrock:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Supported models:
# - anthropic.claude-3-5-sonnet-20241022-v2:0 (recommended)
# - amazon.nova-pro-v1:0
# - anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─────────────────────────────────────────────
# GITHUB INTELLIGENCE INTEGRATION (Optional)
# ─────────────────────────────────────────────
# Personal access token with repo read scope (optional, works with public repos or shows mock/disconnected state)
GITHUB_TOKEN=
# Default repository to query if none specified in prompt
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ─────────────────────────────────────────────
# FRONTEND SETTINGS (Vite)
# ─────────────────────────────────────────────
# NOTE: Vite variables prefixed with VITE_ are embedded into the client bundle at BUILD time.
# Never place secret tokens or private keys in variables prefixed with VITE_.
# In local development, the Vite dev server proxies /api calls to http://localhost:3001.
# In Docker production, Nginx reverse-proxies /api/ calls directly to the backend service.
VITE_API_BASE_URL=
